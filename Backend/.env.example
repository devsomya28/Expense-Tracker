# Port the server listens on. Most deploy platforms (Render, Railway, etc.)
# set this automatically - only needed for local dev.
PORT=3000

# MongoDB connection string. Use MongoDB Atlas (or similar) for production -
# a local mongodb://localhost:27017/... URI will not work once deployed.
MONGO_URI=your_mongodb_connection_string

# Secret used to sign JWTs. Use a long, random string in production
# (e.g. `openssl rand -base64 48`) - never reuse the dev value.
JWT_SECRET=your_jwt_secret

# Google Gemini API key, used for the AI spending-analysis / Ask AI features.
GOOGLE_API_KEY=your_google_api_key

# Comma-separated list of origins allowed to call this API with credentials.
# Include your deployed frontend URL, and localhost for local dev.
# Example: FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Set to "production" when deployed. Controls cookie security flags
# (secure + SameSite=None in production, so login works across two domains).
NODE_ENV=development
