# URL of your running backend's API root (the Express app mounts routes under /api).
# Local dev default matches the backend's default PORT (3000).
# In production, point this at your deployed backend, e.g.
# VITE_API_URL=https://your-backend.onrender.com/api
#
# Whatever origin this frontend runs on (localhost:5173 in dev, your deployed
# frontend URL in production) must be listed in the backend's FRONTEND_URL env var.
VITE_API_URL=http://localhost:3000/api
